{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public author and reader profile without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "username": { "type": "string", "minLength": 2, "maxLength": 50, "pattern": "^[a-zA-Z0-9_\\-.]+$" },
        "bio": { "type": "string", "maxLength": 500 },
        "photoUrl": { "type": "string", "maxLength": 200000 },
        "isVerified": { "type": "boolean" },
        "role": { "type": "string", "enum": ["reader", "author", "admin", "USER", "ADMIN"] },
        "visibility": { "type": "string", "enum": ["public"] },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "username", "bio", "photoUrl", "isVerified", "role", "visibility", "followersCount", "followingCount", "createdAt", "updatedAt"]
    },
    "RoleRecord": {
      "title": "RoleRecord",
      "description": "Role-based access control assignment record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["USER", "ADMIN"] },
        "assignedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "assignedBy", "updatedAt"]
    },
    "LiteraryPost": {
      "title": "LiteraryPost",
      "description": "Draft, submitted, reviewed, or published literary manuscript in Arabic, Malayalam, or English.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "authorUsername": { "type": "string", "minLength": 1, "maxLength": 50 },
        "authorPhoto": { "type": "string", "maxLength": 200000 },
        "authorVerified": { "type": "boolean" },
        "language": { "type": "string", "enum": ["en", "ar", "ml"] },
        "section": { "type": "string", "enum": ["fiction", "poetry", "non-fiction"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "content": { "type": "string", "minLength": 1, "maxLength": 50000 },
        "coverUrl": { "type": "string", "maxLength": 300000 },
        "aiScore": { "type": "integer" },
        "aiVerdict": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["draft", "pending", "under_review", "accepted", "revision_requested", "rejected", "published"] },
        "viewsCount": { "type": "integer" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "authorUsername", "authorPhoto", "authorVerified", "language", "section", "title", "subtitle", "content", "coverUrl", "aiScore", "aiVerdict", "status", "viewsCount", "likesCount", "commentsCount", "createdAt", "updatedAt"]
    },
    "PublicationRecord": {
      "title": "PublicationRecord",
      "description": "Official publication record for an accepted and published manuscript.",
      "type": "object",
      "properties": {
        "manuscriptId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "language": { "type": "string", "enum": ["en", "ar", "ml"] },
        "section": { "type": "string", "enum": ["fiction", "poetry", "non-fiction"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "publishedBy": { "type": "string", "minLength": 1, "maxLength": 100 },
        "publishedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["manuscriptId", "authorId", "authorName", "language", "section", "title", "publishedBy", "publishedAt"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Language and literary section category managed by administrators.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 120 },
        "language": { "type": "string", "enum": ["en", "ar", "ml", "all"] },
        "section": { "type": "string", "enum": ["fiction", "poetry", "non-fiction"] },
        "description": { "type": "string", "maxLength": 300 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "language", "section", "description", "isActive", "createdAt", "updatedAt"]
    },
    "AnnouncementItem": {
      "title": "AnnouncementItem",
      "description": "Website editorial announcement managed by administrators.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "content": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "language": { "type": "string", "enum": ["en", "ar", "ml", "all"] },
        "isActive": { "type": "boolean" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "language", "isActive", "authorName", "createdAt", "updatedAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Reader comment on a literary work.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 200000 },
        "authorVerified": { "type": "boolean" },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "visibility": { "type": "string", "enum": ["public"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "authorName", "authorPhoto", "authorVerified", "text", "visibility", "createdAt"]
    },
    "StoryItem": {
      "title": "StoryItem",
      "description": "Instagram/WhatsApp style story shared from a literary post for the homepage.",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postTitle": { "type": "string", "minLength": 1, "maxLength": 200 },
        "postSection": { "type": "string", "enum": ["fiction", "poetry", "non-fiction"] },
        "postLanguage": { "type": "string", "enum": ["en", "ar", "ml"] },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 600 },
        "coverUrl": { "type": "string", "maxLength": 300000 },
        "authorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 200000 },
        "authorVerified": { "type": "boolean" },
        "durationSeconds": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["public"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "postTitle", "postSection", "postLanguage", "excerpt", "coverUrl", "authorId", "authorName", "authorPhoto", "authorVerified", "durationSeconds", "visibility", "createdAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Instagram-style direct message between two users.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "senderPhoto": { "type": "string", "maxLength": 200000 },
        "receiverId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiverName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "receiverPhoto": { "type": "string", "maxLength": 200000 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "senderPhoto", "receiverId", "receiverName", "receiverPhoto", "text", "createdAt"]
    },
    "FollowRelation": {
      "title": "FollowRelation",
      "description": "Follow relationship between a follower and an author.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "followingId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Notification for newly published submissions, blue tick awards, and admin alerts.",
      "type": "object",
      "properties": {
        "targetUserId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "type": "string", "enum": ["published", "submission", "verified", "new_account", "admin_notice", "status_update"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "postId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["targetUserId", "actorId", "actorName", "type", "title", "postId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public author and reader profiles"
    },
    "/roles/{userId}": {
      "schema": { "$ref": "#/entities/RoleRecord" },
      "description": "Role-based access control records (USER vs ADMIN)"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/LiteraryPost" },
      "description": "Literary drafts, submissions, and published works"
    },
    "/publications/{publicationId}": {
      "schema": { "$ref": "#/entities/PublicationRecord" },
      "description": "Official catalog publications"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CategoryItem" },
      "description": "Trilingual literary categories"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/AnnouncementItem" },
      "description": "Website editorial announcements"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments on published literary works"
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/StoryItem" },
      "description": "Homepage stories created from literary posts"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Direct messages between users"
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/FollowRelation" },
      "description": "Follower-to-author social graph records"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Publication and account notifications"
    }
  }
}
